# Copy this file to .env.local (already gitignored) and fill in real values
# from your Supabase project settings (Project Settings -> API).

# Public — safe to ship to the browser. Used by client components.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — NEVER expose to the browser. Used by Next.js server routes
# (join flow, play/attempt writes, AI generation) to bypass RLS as a trusted
# server context. Do not prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only — the Anthropic API key, used only from server routes for AI
# question generation / tip sheets. Never sent to any browser.
ANTHROPIC_API_KEY=

# A long random string used to sign student session cookies issued by /join.
# Generate one yourself, e.g.: openssl rand -base64 32
STUDENT_SESSION_SECRET=
